# ---------------------------------------------------------------
# KIRO - archivos que nunca deben llegar al repositorio
# ---------------------------------------------------------------

# Configuracion con credenciales reales (se versiona el .example)
app/config/config.php
.env

# Secretos locales: claves de cuentas tecnicas, herramientas y pruebas
storage/secretos/

# Evidencias con datos: exportaciones, capturas y manifiestos completos
storage/evidencias/
docs/evidencias/**/datos_privados/
docs/evidencias/**/capturas/
*.csv

# Registros y archivos temporales
storage/logs/*
!storage/logs/.gitkeep
*.log
*.tmp

# Entorno de editor y sistema operativo
.idea/
.vscode/
Thumbs.db
desktop.ini
.DS_Store

# Dependencias futuras (por si se incorpora Composer mas adelante)
vendor/
